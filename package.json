{
  "name": "finn-intelligence-starter",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "scripts": {
    "start": "node start.js",
    "dev": "node start.js",
    "server": "cd finn-intelligence/server && npm run dev",
    "client": "cd finn-intelligence/client && npm run dev",
    "test": "cd finn-intelligence/server && node --test portfolio.test.js pushEngine.test.js askFinn.test.js researchAi.test.js",
    "build": "cd finn-intelligence/client && npm run build",
    "build:client": "cd finn-intelligence/client && npm run build",
    "start:server": "cd finn-intelligence/server && npm start"
  }
}
