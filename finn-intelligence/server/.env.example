# ---------------------------------------------------------------------------
# Server Environment Configuration
# ---------------------------------------------------------------------------
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# In production, set a strong random secret (e.g. openssl rand -base64 32)
JWT_SECRET=replace_with_a_secure_random_jwt_secret_for_production
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Database Storage (SQLite)
# ---------------------------------------------------------------------------
# Optional: path to SQLite database file.
# On Render free tier without disk: /tmp/finn.db
# With persistent disk: /var/data/finn.db
DATABASE_PATH=/tmp/finn.db

# ---------------------------------------------------------------------------
# TejHQ — Primary market-data provider
# ---------------------------------------------------------------------------
# Keyless endpoints (OHLCV, snapshot, corporate actions) work without a key.
# Free API key unlocks /v1/adjusted (back-adjusted prices) and /v1/symbols.
# Retail/Pro key unlocks /v1/metrics, /v1/batch, /v1/resolve, /v1/screener.
#
# Get your free key at: https://tejhq.dev/keys
# Keys look like: tej_live_0123456789abcdef0123456789abcdef
# ---------------------------------------------------------------------------
TEJHQ_BASE_URL=https://api.tejhq.dev
TEJHQ_API_KEY=replace_with_your_free_key
TEJHQ_EXCHANGE=nse

# ---------------------------------------------------------------------------
# AI Research Q&A: Google Gemini (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Cache TTLs (milliseconds)
# ---------------------------------------------------------------------------
QUOTE_CACHE_MS=3600000
EVENT_CACHE_MS=3600000
RESEARCH_CACHE_MS=900000
CHART_CACHE_MS=1800000
STATUS_CACHE_MS=300000
